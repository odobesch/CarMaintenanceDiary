@using Microsoft.AspNetCore.Components.Authorization
@using CarMaintenanceDiary.Web.Shared
@using BlazorBootstrap
@using System.Drawing
@using System.Security.Claims
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

<CascadingAuthenticationState>
    <Toasts class="p-3" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight" />
    <BlazorBootstrapLayout StickyHeader="true">
        <HeaderSection>
            <div class="ms-auto d-flex align-items-center">
                <ThemeSwitcher Class="me-2" Position="DropdownMenuPosition.End" />
                <LoginDisplay @rendermode="InteractiveServer" />
            </div>
        </HeaderSection>

        <SidebarSection>
            <AuthorizeView>
                <Authorized>
                    <Sidebar2 Href="/"
                              ImageSrc=""
                              Title="Vehicle Care Manager"
                              BadgeText="1.0.0"
                              Class="sidebar-image-only"
                              DataProvider="Sidebar2DataProvider"
                              WidthUnit="Unit.Px" />
                </Authorized>
                <NotAuthorized>
                    <!-- optional placeholder when not logged in -->
                    <div class="p-3 text-muted">Please <a href="/auth/login">log in</a> to see navigation.</div>
                </NotAuthorized>
            </AuthorizeView>
        </SidebarSection>

        <ContentSection>
            <AutoRequireAuth />
            @Body
        </ContentSection>

        <FooterSection>
        </FooterSection>

    </BlazorBootstrapLayout>

    <Component />
</CascadingAuthenticationState>

@code {
    private IEnumerable<NavItem> navItems = default!;

    private Offcanvas offcanvas = default!;

    private async Task OnShowOffcanvasClick() => await offcanvas.ShowAsync();

    private async Task<Sidebar2DataProviderResult> Sidebar2DataProvider(Sidebar2DataProviderRequest request)
    { 
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
       
        var items = GetNavItems().ToList();
        
        var isAdmin = user?.Identity?.IsAuthenticated == true && user.IsInRole("Admin");
        if (!isAdmin)
        {
            items = items.Where(i => !string.Equals(i.Href, "/settings", StringComparison.OrdinalIgnoreCase)).ToList();
        }

        navItems = items;
        return await Task.FromResult(request.ApplyTo(navItems));
    }

    private IEnumerable<NavItem> GetNavItems()
    {
        var list = new List<NavItem>
        {
            new NavItem { Id = "1", Href = "/", IconName = IconName.HouseDoorFill, Text = "Home", Match = NavLinkMatch.All },
            new NavItem { Id = "2", Href = "/vehicles", IconName = IconName.CarFrontFill, Text = "Vehicles" },
            new NavItem { Id = "3", Href = "/fuel-management", IconName = IconName.FuelPump, Text = "Fuel Management" },
            new NavItem { Id = "4", Href = "/fuel-map", IconName = IconName.Map, Text = "Fuel Stations map" },
            new NavItem { Id = "5", Href = "/maintenance", IconName = IconName.Tools, Text = "Maintenance Management" },
            new NavItem { Id = "6", Href = "/settings", IconName = IconName.GearFill, Text = "Settings" }
        };

        return list;
    }
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>