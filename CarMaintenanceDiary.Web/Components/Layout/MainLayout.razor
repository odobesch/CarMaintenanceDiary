@using Microsoft.AspNetCore.Components.Authorization
@using CarMaintenanceDiary.Web.Shared
@using CarMaintenanceDiary.Web.Services
@using BlazorBootstrap
@using System.Drawing
@inherits LayoutComponentBase

<CascadingAuthenticationState>
	<Toasts class="p-3" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight" />
	<BlazorBootstrapLayout StickyHeader="true">
		<HeaderSection>
			<ThemeSwitcher Class="ps-3 ps-lg-2" Position="DropdownMenuPosition.End" />
			<NavLink href="/settings" class="btn btn-outline-secondary btn-sm" aria-label="Settings">
				<Icon Name="IconName.GearFill" class="me-1" />
				<span class="d-none d-sm-inline">Settings</span>
			</NavLink>

			<!-- login / logout display on the right -->
			<div class="ms-auto d-flex align-items-center">
				<LoginDisplay @rendermode="InteractiveServer" />
			</div>
		</HeaderSection>

		<SidebarSection>
			<AuthorizeView>
				<Authorized>
					<Sidebar2 Href="/"
							  ImageSrc="https://demos.blazorbootstrap.com/images/logo/logo-white.svg"
							  Title="Car Maintenance"
							  BadgeText="3.2.0"
							  DataProvider="Sidebar2DataProvider"
							  WidthUnit="Unit.Px" />
				</Authorized>
				<NotAuthorized>
					<!-- optional placeholder when not logged in -->
					<div class="p-3 text-muted">Please <a href="/auth/login">log in</a> to see navigation.</div>
				</NotAuthorized>
			</AuthorizeView>
		</SidebarSection>

		<ContentSection>
			<AutoRequireAuth />
			@Body
		</ContentSection>

		<FooterSection>
		</FooterSection>

	</BlazorBootstrapLayout>

	<Component />		
</CascadingAuthenticationState>

@code {
	private IEnumerable<NavItem> navItems = default!;

	private Offcanvas offcanvas = default!;
	private async Task OnShowOffcanvasClick() => await offcanvas.ShowAsync();

	private async Task<Sidebar2DataProviderResult> Sidebar2DataProvider(Sidebar2DataProviderRequest request)
	{
		navItems = GetNavItems();
		return await Task.FromResult(request.ApplyTo(navItems));
	}

	private IEnumerable<NavItem> GetNavItems()
	{
		return new List<NavItem>
 {
 new NavItem { Id = "1", Href = "/", IconName = IconName.HouseDoorFill, Text = "Home", Match = NavLinkMatch.All },
 new NavItem { Id = "2", Href = "/counter", IconName = IconName.PlusSquareFill, Text = "Counter" },
 new NavItem { Id = "3", Href = "/weather", IconName = IconName.Table, Text = "Weather" },
 new NavItem { Id = "4", Href = "/vehicles", IconName = IconName.CarFrontFill, Text = "Vehicles" },
 new NavItem { Id = "5", Href = "/fuel-management", IconName = IconName.FuelPump, Text = "Fuel Management" },
 new NavItem { Id = "6", Href = "/fuel-map", IconName = IconName.Map, Text = "Fuel Stations map" },
 new NavItem { Id = "7", Href = "/maintenance", IconName = IconName.Tools, Text = "Maintenance Management" },
 };
	}
}

<div id="blazor-error-ui">
	An unhandled error has occurred.
	<a href="" class="reload">Reload</a>
	<a class="dismiss">🗙</a>
</div>