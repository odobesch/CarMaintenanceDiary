@page "/auth/logout"
@using CarMaintenanceDiary.Web.Authentication
@rendermode InteractiveServer
@inject CustomAuthStateProvider AuthProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<Logout> Logger
@inject IJSRuntime JS

<PageTitle>Log Out</PageTitle>

<div class="container py-4">
    <h3>Signing out…</h3>
    <p>Please wait — you will be redirected shortly.</p>
</div>

@code {
    private bool _navigated;

    protected override async Task OnInitializedAsync()
    {
        try
        {            
            await AuthProvider.MarkUserAsLoggedOutAsync();
            
            Navigation.NavigateTo("/auth/login", replace: true, forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Logout failed; redirecting to login anyway.");
            Navigation.NavigateTo("/auth/login", replace: true, forceLoad: true);
        }
    }    

    private void NavigateHome()
    {
        if (_navigated)
            return;
        _navigated = true;
        Navigation.NavigateTo("/", replace: true, forceLoad: true);
    }
}
