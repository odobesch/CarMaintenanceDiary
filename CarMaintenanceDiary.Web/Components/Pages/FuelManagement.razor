@page "/fuel-management"
@using CarMaintenanceDiary.Application.Interfaces
@using CarMaintenanceDiary.Shared.DTOs
@using CarMaintenanceDiary.Shared.DTOs.Fuel
@using System.Globalization
@inject IJSRuntime JS
@inject IVehicleService VehicleService
@inject IFuelService FuelService
@inject ToastService ToastService
@inject ILogger<FuelManagement> Logger

<style>
    /* Thumbnails */
    .photo-thumbnail img {        
        object-fit: cover;
        border: 1px solid #ccc;
        cursor: pointer;
        display: block;
    }

    .photo-thumbnail .photo-actions {
        margin-top: 6px;
    }

    /* Make detail modal wider and ensure image fits within viewport */
    .photo-detail-modal .modal-dialog {
        max-width: 90vw;
    }

    .photo-detail-modal .modal-body {
        text-align: center;
    }

        .photo-detail-modal .modal-body img {
            max-width: 90vw;
            max-height: 85vh;
            object-fit: contain;
        }
</style>

<h3>Fuel Management</h3>

@if (isLoading)
{
    <div class="loading-overlay">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    @if (!vehicles.Any())
    {
        <div class="alert alert-warning" role="alert">
            <strong>No vehicles found!</strong> Please add a vehicle to manage fuel records.
        </div>
    }
    else
    {
        <select class="form-select mb-3" @onchange="OnVehicleSelected" value="@selectedVehicle?.Id">
            @foreach (var vehicle in vehicles)
            {
                <option value="@vehicle.Id">@vehicle.Make @vehicle.Model (@vehicle.LicensePlate)</option>
            }
        </select>

        @if (selectedVehicle != null)
        {
            <h4>Fuel Records for @selectedVehicle.Make @selectedVehicle.Model (@selectedVehicle.LicensePlate)</h4>
            <button class="btn btn-success mb-3" @onclick="OpenAddFuelModal">Add Fuel Record</button>

            <Grid TItem="FuelRecordDto"
            Data="@selectedVehicle.FuelRecords"
            Class="table table-hover table-bordered"
            AllowFiltering="true"
            AllowPaging="true" PageSize="10"
            PageSizeSelectorVisible="true"
            PageSizeSelectorItems="@(new int[] { 5,10,20 })"
            AllowSorting="true"
            AllowSelection="false"
            SelectionMode="GridSelectionMode.Single"
            Responsive="true">
                <GridColumns>
                    <GridColumn TItem="FuelRecordDto" Field="Date" HeaderText="Date"
                    PropertyName="Date" SortKeySelector="v => v.Date"
                    HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                        @context.Date.ToShortDateString()
                    </GridColumn>
                    <GridColumn TItem="FuelRecordDto" Field="Odometer" HeaderText="Odometer (km)"
                    PropertyName="Odometer" SortKeySelector="v => v.Odometer"
                    HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                        @context.Odometer
                    </GridColumn>
                    <GridColumn TItem="FuelRecordDto" Field="Liters" HeaderText="Fuel Added (liters)"
                    PropertyName="Liters" SortKeySelector="v => v.Liters"
                    HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                        @context.Liters.ToString("F2")
                    </GridColumn>
                    <GridColumn TItem="FuelRecordDto" Field="PricePerLiter" HeaderText="Price Per Liter"
                    PropertyName="PricePerLiter" SortKeySelector="v => v.PricePerLiter"
                    HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                        @context.PricePerLiter.ToString("F2")
                    </GridColumn>
                    <GridColumn TItem="FuelRecordDto" HeaderText="Total Cost"
                    HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                        @((context.Liters * (double)context.PricePerLiter).ToString("F2"))
                    </GridColumn>
                    <GridColumn TItem="FuelRecordDto" Field="FuelStation" HeaderText="Fuel Station"
                    PropertyName="FuelStation" SortKeySelector="v => v.FuelStation"
                    HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                        @context.FuelStation
                    </GridColumn>
                    <GridColumn TItem="FuelRecordDto" Field="FullTank" HeaderText="Full Tank"
                    PropertyName="FullTank" SortKeySelector="v => v.FullTank"
                    HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                        @(context.FullTank ? "Yes" : "No")
                    </GridColumn>
                    <GridColumn TItem="FuelRecordDto" Field="Edit/Delete" HeaderText="Edit/Delete">
                        <button class="btn btn-sm btn-secondary me-1" @onclick="() => OpenPhotos(context)">Images</button>
                        <button class="btn btn-sm btn-primary me-1" @onclick="() => EditFuelRecord(context)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteFuelRecord(context)">Delete</button>
                    </GridColumn>
                </GridColumns>
            </Grid>

            <h5>Average Fuel Consumption: @selectedVehicle.AverageFuelConsumption L/100km</h5>

            <div class="overflow-x-auto" style="min-width: 100%;">
                <LineChart @ref="lineChart" Width="800" />
            </div>

            <Accordion Flush="true">
                <AccordionItem Title="📅 Monthly Fuel Summary">
                    <Content>
                        <Grid TItem="MonthlyFuelSummaryDto"
                        Data="@monthlySummaries"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        Responsive="true"
                        Class="table table-sm table-bordered text-center">

                            <GridColumns>
                                <GridColumn TItem="MonthlyFuelSummaryDto" HeaderText="MonthName" SortKeySelector="m => m.MonthName">
                                    @context.MonthName
                                </GridColumn>
                                <GridColumn TItem="MonthlyFuelSummaryDto" HeaderText="Total Liters" SortKeySelector="m => m.TotalLiters">
                                    @context.TotalLiters.ToString("F2")
                                </GridColumn>
                                <GridColumn TItem="MonthlyFuelSummaryDto" HeaderText="Total cost" SortKeySelector="m => m.TotalCost">
                                    @context.TotalCost.ToString("C", new System.Globalization.CultureInfo("cs-CZ"))
                                </GridColumn>
                                <GridColumn TItem="MonthlyFuelSummaryDto" HeaderText="Avg. Price/L" SortKeySelector="m => m.AveragePricePerLiter">
                                    @context.AveragePricePerLiter.ToString("F2")
                                </GridColumn>
                                <GridColumn TItem="MonthlyFuelSummaryDto" HeaderText="Avg. L/100km" SortKeySelector="m => m.AverageConsumptionPer100Km">
                                    @context.AverageConsumptionPer100Km.ToString("F2")
                                </GridColumn>
                            </GridColumns>
                        </Grid>
                    </Content>
                </AccordionItem>

                <AccordionItem Title="📈 Yearly Fuel Summary">
                    <Content>
                        <Grid TItem="YearlyFuelSummaryDto"
                        Data="@yearlySummaries"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        Responsive="true"
                        Class="table table-sm table-bordered text-center">

                            <GridColumns>
                                <GridColumn TItem="YearlyFuelSummaryDto" HeaderText="Year" SortKeySelector="m => m.Year">
                                    @context.Year
                                </GridColumn>
                                <GridColumn TItem="YearlyFuelSummaryDto" HeaderText="Total Liters" SortKeySelector="m => m.TotalLiters">
                                    @context.TotalLiters.ToString("F2")
                                </GridColumn>
                                <GridColumn TItem="YearlyFuelSummaryDto" HeaderText="Total cost" SortKeySelector="m => m.TotalCost">
                                    @context.TotalCost.ToString("C", new System.Globalization.CultureInfo("cs-CZ"))
                                </GridColumn>
                                <GridColumn TItem="YearlyFuelSummaryDto" HeaderText="Avg. Price/L" SortKeySelector="m => m.AveragePricePerLiter">
                                    @context.AveragePricePerLiter.ToString("F2")
                                </GridColumn>
                                <GridColumn TItem="YearlyFuelSummaryDto" HeaderText="Avg. L/100km" SortKeySelector="m => m.AverageConsumptionPer100Km">
                                    @context.AverageConsumptionPer100Km.ToString("F2")
                                </GridColumn>
                            </GridColumns>

                        </Grid>
                    </Content>
                </AccordionItem>
            </Accordion>
        }
    }
}

<Modal @ref="fuelModal" Title="@(isEditMode ? "Edit Fuel Record" : "Add Fuel Record")">
    <BodyTemplate>
        
            <EditForm Model="newFuelRecord" OnValidSubmit="SaveFuelRecord" id="fuel-form">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-2">
                    <label>Date <span style="color: red;">*</span></label>
                <RadzenDatePicker @bind-Value="newFuelRecord.Date" DateFormat="dd.MM.yyyy" Style="width: 100%;"
                                  AllowClear="true" ShowButton="false" Culture="@(new System.Globalization.CultureInfo("cs-CZ"))" />
                <ValidationMessage For="@(() => newFuelRecord.Date)" />
            </div>

            <div class="mb-2">
                <label>Odometer (km) <span style="color: red;">*</span></label>
                <InputNumber class="form-control" @bind-Value="newFuelRecord.Odometer" Min="0.01" />
                <ValidationMessage For="@(() => newFuelRecord.Odometer)" />
            </div>

            <div class="mb-2">
                <label>Fuel Added (liters) <span style="color: red;">*</span></label>
                <InputNumber class="form-control" @bind-Value="newFuelRecord.Liters" Min="0.01" />
                <ValidationMessage For="@(() => newFuelRecord.Liters)" />
            </div>

            <div class="mb-2">
                <label>Price Per Liter <span style="color: red;">*</span></label>
                <InputNumber class="form-control" @bind-Value="newFuelRecord.PricePerLiter" Min="0.01" />
                <ValidationMessage For="@(() => newFuelRecord.PricePerLiter)" />
            </div>

            <div class="mb-2">
                <label>Fuel Station</label>
                <InputText class="form-control" @bind-Value="newFuelRecord.FuelStation" />
                <ValidationMessage For="@(() => newFuelRecord.FuelStation)" />
            </div>

            <div class="mb-2">
                <label>Full Tank</label>
                <InputCheckbox class="form-check-input" @bind-Value="newFuelRecord.FullTank" />
                <ValidationMessage For="@(() => newFuelRecord.FullTank)" />
            </div>
        </EditForm>
        
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="CloseFuelModal">Close</Button>
        <button type="submit" class="btn btn-primary" form="fuel-form">@(isEditMode ? "Save Changes" : "Add Record")
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span>
            }
        </button>
    </FooterTemplate>
</Modal>

<Modal @ref="photoModal" Title="Images" Class="photo-modal" Keyboard="false" Backdrop="ModalBackdrop.Static">
    <BodyTemplate>
        <div class="mb-2">
            <label>Upload photos</label>
            <InputFile OnChange="UploadPhotoFiles" multiple />
        </div>

        <div class="d-flex flex-wrap">
            @if (photoIdsForRecord?.Any() == true)
            {
                foreach (var pid in photoIdsForRecord)
                {
                    <div class="m-2 text-center photo-thumbnail">
                        <div class="m-2 text-center photo-thumbnail">
                            <img src="@PhotoUrl(pid, 300, 150)"
                                 srcset="@PhotoUrl(pid, 300, 150) 1x,
                                        @PhotoUrl(pid, 300, 150, dpr: 2) 2x"
                                 width="300" height="150"
                                 loading="lazy" decoding="async"
                                 @onclick="() => ShowPhotoDetail(pid)" />
                            <div class="mt-1 photo-actions">
                                <button class="btn btn-sm btn-danger" @onclick="() => DeletePhoto(pid)">Delete</button>
                            </div>
                        </div>                       
                    </div>
                }
            }
            else
            {
                <div>No photos for this record.</div>
            }
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="ClosePhotoModal">Close</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="photoDetailModal" Title="Image Detail" Class="photo-detail-modal" Keyboard="true" Backdrop="ModalBackdrop.True">
    <BodyTemplate>
        @if (!string.IsNullOrEmpty(selectedPhotoUrl))
        {
            <div class="text-center">
                <img src="@selectedPhotoUrl" />
            </div>
        }
        else
        {
            <div>Loading...</div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!string.IsNullOrEmpty(selectedPhotoUrl))
        {
            <a class="btn btn-link" href="@selectedPhotoUrl" target="_blank" rel="noopener">Open in new tab</a>
            <button class="btn btn-sm btn-secondary ms-2" @onclick="DownloadPhoto">Download</button>
        }
        <Button Color="ButtonColor.Secondary" @onclick="ClosePhotoDetailModal">Close</Button>
    </FooterTemplate>
</Modal>

<ConfirmDialog @ref="confirmDialog" />

@implements IAsyncDisposable

<!--
  Updated ESC handler:
  - Runs in JS, closes only the topmost visible DOM modal (.modal.show).
  - Notifies the component which modal class was closed so C# can update state (selectedPhotoId / selectedPhotoUrl).
  This avoids calling component HideAsync from C#, which previously caused both modals to close.
-->
<script>
    window.carMaintenance = window.carMaintenance || {};
    window.carMaintenance.escHandler = window.carMaintenance.escHandler || {
        _listener: null,
        register: function (dotNetRef) {
            if (this._listener) return;
            this._listener = function (e) {
                if (e.key !== "Escape") return;

                // find all visible modals (Bootstrap root .modal.show)
                const visible = Array.from(document.querySelectorAll('.modal.show'));
                if (visible.length === 0) return;

                const top = visible[visible.length - 1];

                // try bootstrap API first
                try {
                    if (window.bootstrap && window.bootstrap.Modal) {
                        const inst = window.bootstrap.Modal.getInstance(top) || new window.bootstrap.Modal(top);
                        inst.hide();
                    } else {
                        // fallback: manually hide DOM modal (best-effort)
                        top.classList.remove('show');
                        top.setAttribute('aria-hidden', 'true');
                        top.style.display = 'none';
                        const backdrops = document.querySelectorAll('.modal-backdrop');
                        if (backdrops.length) {
                            backdrops[backdrops.length - 1].remove();
                        }
                        // remove modal-open if no more modals visible
                        if (document.querySelectorAll('.modal.show').length === 0) {
                            document.body.classList.remove('modal-open');
                        }
                    }
                } catch (err) {
                    // ignore DOM/Bootstrap errors
                }

                const closedIsDetail = top.classList.contains('photo-detail-modal');
                const closedIsPhotos = top.classList.contains('photo-modal');
                const modalName = closedIsDetail ? 'photoDetailModal' : (closedIsPhotos ? 'photoModal' : 'unknown');

                // notify the component so it can update its state
                dotNetRef.invokeMethodAsync('NotifyModalClosed', modalName).catch(() => { /* ignore */ });
            };
            window.addEventListener('keydown', this._listener);
        },
        unregister: function () {
            if (!this._listener) return;
            window.removeEventListener('keydown', this._listener);
            this._listener = null;
        }
    };
</script>

@code {
    private const long MaxUploadBytes = 10_000_000;
    private List<VehicleDto> vehicles = new();
    private VehicleDto? selectedVehicle;
    private FuelRecordDto newFuelRecord = new();
    private Modal? fuelModal;
    private bool isLoading = true;

    private LineChart lineChart = default!;
    private LineChartOptions lineChartOptions = new();
    private ChartData chartData = new();

    private bool isEditMode = false;
    private FuelRecordDto? editingRecord;

    private bool isFirstRender = true;

    private ConfirmDialog confirmDialog = default!;

    private List<MonthlyFuelSummaryDto> monthlySummaries = new();
    private List<YearlyFuelSummaryDto> yearlySummaries = new();

    private bool isSaving;

    private Modal? photoModal;
    private int photoRecordId;
    private List<int> photoIdsForRecord = new();

    private Modal? photoDetailModal;
    private int? selectedPhotoId;
    private string? selectedPhotoUrl;

    private DotNetObjectReference<FuelManagement>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            vehicles = await VehicleService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load vehicles.");
            ToastService.Notify(new ToastMessage(ToastType.Danger, "Unable to load vehicles."));
        }

        if (vehicles.Any())
        {
            selectedVehicle = vehicles.First();
            await LoadFuelRecords(selectedVehicle.Id);
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (selectedVehicle is not null && lineChart is not null)
        {
            await lineChart.InitializeAsync(chartData, lineChartOptions);
        }

        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("carMaintenance.escHandler.register", dotNetRef);
        }

        if (firstRender == false)
        {
            await JS.InvokeVoidAsync("initFlatpickr", "#fuelDate");
        }
    }

    private async Task OnVehicleSelected(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out var selectedId) && selectedId > 0)
            {
                selectedVehicle = vehicles.FirstOrDefault(v => v.Id == selectedId);
                await LoadFuelRecords(selectedId);

                if (lineChart is not null)
                {
                    await lineChart.InitializeAsync(chartData, lineChartOptions);
                }
            }
            else
            {
                selectedVehicle = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load fuel records for selected vehicle.");
            ToastService.Notify(new ToastMessage(ToastType.Danger, "Failed to load fuel records."));
        }
    }

    private async Task LoadFuelRecords(int vehicleId)
    {
        try
        {
            var fuelRecords = (await FuelService.GetFuelRecordsAsync(vehicleId))
                .OrderByDescending(fr => fr.Odometer)
                .ToList();

            if (selectedVehicle is not null && selectedVehicle.Id == vehicleId)
            {
                selectedVehicle.FuelRecords = fuelRecords;
            }

            UpdateChartData(fuelRecords);
            monthlySummaries = await FuelService.GetMonthlyFuelSummariesAsync(vehicleId);
            yearlySummaries = await FuelService.GetYearlyFuelSummariesAsync(vehicleId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load fuel records.");
            ToastService.Notify(new ToastMessage(ToastType.Danger, "Error loading fuel data."));
        }
    }

    private void UpdateChartData(List<FuelRecordDto> records)
    {
        var colors = ColorUtility.CategoricalTwelveColors;
        var labels = new List<string>();
        var consumptionData = new List<double?>();
        var costPer100kmData = new List<double?>();

        for (int i = 1; i < records.Count; i++)
        {
            var prev = records[i - 1];
            var curr = records[i];

            double km = curr.Odometer - prev.Odometer;
            double liters = curr.Liters;
            double cost = liters * (double)curr.PricePerLiter;

            if (km > 0)
            {
                consumptionData.Add((liters / km) * 100);
                costPer100kmData.Add((cost / km) * 100);
                labels.Add(curr.Date.ToShortDateString());
            }
        }

        if (!consumptionData.Any())
        {
            labels.Add("No Data");
            consumptionData.Add(null);
            costPer100kmData.Add(null);
        }

        chartData = new ChartData
        {
            Labels = labels,
            Datasets = new List<IChartDataset>
            {
                new LineChartDataset
                {
                    Label = "L/100km",
                    Data = consumptionData,
                    BackgroundColor = colors[0],
                    BorderColor = colors[0],
                    BorderWidth = 2,
                    HoverBorderWidth = 3,
                    PointRadius = new List<double> { 3 },
                    PointHoverRadius = new List<double> { 6 },
                    Fill = false
                },
                new LineChartDataset
                {
                    Label = "Cost/100km (CZK)",
                    Data = costPer100kmData,
                    BackgroundColor = colors[1],
                    BorderColor = colors[1],
                    BorderWidth = 2,
                    HoverBorderWidth = 3,
                    PointRadius = new List<double> { 3 },
                    PointHoverRadius = new List<double> { 6 },
                    Fill = false
                }
            }
        };

        lineChartOptions = new LineChartOptions
        {
            Responsive = true,
            Interaction = new Interaction { Mode = InteractionMode.Index },
            Plugins = new()
            {
                Title = new()
                {
                    Display = true,
                    Text = "Fuel Consumption and Cost per 100 km"
                }
            }
        };
    }

    private void OpenAddFuelModal()
    {
        isEditMode = false;
        newFuelRecord = new FuelRecordDto
        {
            Date = DateTime.Today
        };
        fuelModal?.ShowAsync();
    }

    private void CloseFuelModal()
    {
        fuelModal?.HideAsync();
    }

    private async Task AddFuelRecord()
    {
        if (selectedVehicle is null)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "No vehicle selected."));
            return;
        }

        isSaving = true;

        try
        {
            await FuelService.AddFuelRecordAsync(selectedVehicle.Id, newFuelRecord);

            ToastService.Notify(new ToastMessage(ToastType.Success, "Fuel record added successfully."));

            newFuelRecord = new FuelRecordDto();
            fuelModal?.HideAsync();

            await LoadFuelRecords(selectedVehicle.Id);

            if (lineChart is not null)
            {
                await lineChart.InitializeAsync(chartData, lineChartOptions);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add fuel record.");
            ToastService.Notify(new ToastMessage(ToastType.Danger, "Failed to add fuel record."));
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditFuelRecord(FuelRecordDto record)
    {
        isEditMode = true;
        editingRecord = record;

        newFuelRecord = new FuelRecordDto
        {
            Id = record.Id,
            Date = record.Date,
            Odometer = record.Odometer,
            Liters = record.Liters,
            PricePerLiter = record.PricePerLiter,
            FuelStation = record.FuelStation,
            FullTank = record.FullTank
        };

        fuelModal?.ShowAsync();
    }

    private async Task SaveFuelRecord()
    {
        if (selectedVehicle is null)
            return;

        isSaving = true;
        try
        {
            if (isEditMode && editingRecord is not null)
            {
                await FuelService.UpdateFuelRecordAsync(newFuelRecord);
            }
            else
            {
                await FuelService.AddFuelRecordAsync(selectedVehicle.Id, newFuelRecord);
            }

            fuelModal?.HideAsync();
            newFuelRecord = new FuelRecordDto();
            editingRecord = null;

            await LoadFuelRecords(selectedVehicle.Id);
            await lineChart.InitializeAsync(chartData, lineChartOptions);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Save failed");
            ToastService.Notify(new ToastMessage(ToastType.Danger, "Failed to save record."));
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteFuelRecord(FuelRecordDto record)
    {
        if (selectedVehicle is null)
            return;

        var confirmed = await confirmDialog.ShowAsync($"Delete fuel record", $"Are you sure you want to delete the fuel record from {record.Date}?");

        if (confirmed)
        {
            await FuelService.DeleteFuelRecordAsync(record.Id);
            await LoadFuelRecords(selectedVehicle.Id);
            await lineChart.InitializeAsync(chartData, lineChartOptions);

            ToastService.Notify(new ToastMessage(ToastType.Success, "Fuel record deleted successfully."));
        }
        else
        {
            ToastService.Notify(new ToastMessage(ToastType.Secondary, "Delete cancelled."));
        }
    }

    private string PhotoUrl(
        int id,
        int? w = null,
        int? h = null,
        string mode = "crop",
        int dpr = 1,
        string? format = null,
        int? q = null)
    {
        return (w.HasValue && h.HasValue)
            ? FuelService.GetPhotoUrl(id, w.Value, h.Value, mode, dpr, format, q)
            : FuelService.GetPhotoUrl(id);
    }

    private async Task OpenPhotos(FuelRecordDto record)
    {
        photoRecordId = record.Id;
        var dto = await FuelService.GetFuelRecordByIdAsync(photoRecordId);
        photoIdsForRecord = dto?.PhotoIds ?? new List<int>();

        await photoModal?.ShowAsync();
    }

    private async Task ClosePhotoModal()
    {
        await photoModal?.HideAsync();
        photoIdsForRecord.Clear();
    }

    private string PhotoUrl(int id) => FuelService.GetPhotoUrl(id);

    private async Task ShowPhotoDetail(int photoId)
    {
        selectedPhotoId = photoId;
        selectedPhotoUrl = PhotoUrl(photoId);

        await photoDetailModal?.ShowAsync();
    }

    private async Task ClosePhotoDetailModal()
    {
        selectedPhotoId = null;
        selectedPhotoUrl = null;
        await photoDetailModal?.HideAsync();
    }

    private async Task DownloadPhoto()
    {
        if (string.IsNullOrEmpty(selectedPhotoUrl))
            return;

        await JS.InvokeVoidAsync("open", selectedPhotoUrl, "_blank");
    }

    private async Task UploadPhotoFiles(InputFileChangeEventArgs e)
    {
        if (photoRecordId == 0)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "No record selected for upload."));
            return;
        }

        foreach (var file in e.GetMultipleFiles())
        {
            await using var stream = file.OpenReadStream(MaxUploadBytes);
            try
            {
                var uploadedId = await FuelService.UploadPhotoAsync(photoRecordId, stream, file.Name, file.ContentType);
                var dto = await FuelService.GetFuelRecordByIdAsync(photoRecordId);
                photoIdsForRecord = dto?.PhotoIds ?? new List<int>();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Photo upload failed.");
                ToastService.Notify(new ToastMessage(ToastType.Danger, "Photo upload failed."));
            }
        }

        if (selectedVehicle is not null)
            await LoadFuelRecords(selectedVehicle.Id);
    }

    private async Task DeletePhoto(int photoId)
    {
        try
        {
            await FuelService.DeletePhotoAsync(photoId);
            photoIdsForRecord.Remove(photoId);

            if (selectedPhotoId == photoId)
            {
                await ClosePhotoDetailModal();
            }

            if (photoRecordId != 0)
            {
                var dto = await FuelService.GetFuelRecordByIdAsync(photoRecordId);
                photoIdsForRecord = dto?.PhotoIds ?? new List<int>();
            }

            if (selectedVehicle is not null)
                await LoadFuelRecords(selectedVehicle.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete photo.");
            ToastService.Notify(new ToastMessage(ToastType.Danger, "Failed to delete photo."));
        }
    }

    // JS -> .NET callback: update component state after JS hides a specific modal element.
    [JSInvokable]
    public Task NotifyModalClosed(string modalName)
    {
        // only the detail modal needs component-side cleanup (selectedPhotoId/Url)
        if (modalName == "photoDetailModal")
        {
            selectedPhotoId = null;
            selectedPhotoUrl = null;
            StateHasChanged();
        }
        else if (modalName == "photoModal")
        {
            photoIdsForRecord.Clear();
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("carMaintenance.escHandler.unregister");
        }
        catch
        {
            // ignore if JS not available
        }
        dotNetRef?.Dispose();
    }
}
