@page "/fuel-map"
@using CarMaintenanceDiary.Application.Services
@using CarMaintenanceDiary.Shared.DTOs
@using System.Text.Json
@inject IJSRuntime JS
@inject FuelStationService FuelStationService
@inject ToastService ToastService
@inject ILogger<FuelMap> Logger

<h3>Nearest Fuel Stations</h3>

<div class="mb-3">
    <label for="radiusInput" class="form-label">Search radius (km):</label>
    <InputNumber id="radiusInput" @bind-Value="searchRadiusKm" class="form-control" Min="1" />
</div>

<button class="btn btn-primary mb-3" @onclick="LoadMap">Show Nearby Stations</button>

@if (isLoading)
{
    <div class="loading-overlay">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!stations.Any())
{
    <div class="alert alert-warning">No fuel stations found nearby.</div>
}
else
{
    <div id="map" style="height: 500px;" class="my-4 rounded shadow-sm border"></div>    
}

@code {
    private List<FuelStationDto> stations = new();
    private bool isLoading = false;

    private GeoCoordinate? userLocation;
    private bool shouldInitMap = false; 

    private int searchRadiusKm = 5;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadMap(); // 🔄 Automatically trigger map loading
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // ✅ Only run JS after the div is definitely in the DOM
        if (shouldInitMap && userLocation is not null && stations.Any())
        {
            shouldInitMap = false; // reset so it only runs once
            try
            {
                await JS.InvokeVoidAsync("initFuelMap", stations, userLocation.Latitude, userLocation.Longitude, searchRadiusKm * 1000);
            }
            catch (JSException jsEx)
            {
                Logger.LogError(jsEx, "Failed to init fuel map");
                Console.Error.WriteLine($"JS map error: {jsEx.Message}");
            }
        }
    }

    private async Task LoadMap()
    {
        if (isLoading)
            return;

        isLoading = true;
        stations.Clear();
        StateHasChanged();

        try
        {
            searchRadiusKm = Math.Clamp(searchRadiusKm, 1, 100);

            userLocation = await JS.InvokeAsync<GeoCoordinate>("getUserLocation");
            stations = await FuelStationService.GetNearbyFuelStationsAsync(
                userLocation.Latitude,
                userLocation.Longitude,
                searchRadiusKm * 1000
            );

            shouldInitMap = true;

            if (!stations.Any())
            {
                ToastService.Notify(new ToastMessage(ToastType.Warning, "No fuel stations found in the selected area."));
            }
        }
        catch (JSException jsEx)
        {
            Console.Error.WriteLine($"JS error: {jsEx.Message}");
            Logger.LogError(jsEx, "JS error {0}", jsEx.Message);
            ToastService.Notify(new ToastMessage(ToastType.Danger, "Location access denied or unavailable."));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Unexpected error: {ex.Message}");
            Logger.LogError(ex, "Unexpected error: {0}", ex.Message);
            ToastService.Notify(new ToastMessage(ToastType.Danger, "Failed to load nearby stations. Please try again."));
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class GeoCoordinate
    {
        public double Latitude
        {
            get; set;
        }
        public double Longitude
        {
            get; set;
        }
    }
}
