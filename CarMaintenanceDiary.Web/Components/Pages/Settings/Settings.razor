@page "/settings"
@using BlazorBootstrap

<h3 class="mb-3 d-flex align-items-center">
    <i class="bi bi-gear-fill me-2"></i> Settings
</h3>

<!-- Toolbar with dropdowns -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <Dropdown Color="DropdownColor.Primary">
        <DropdownToggleButton>General</DropdownToggleButton>
        <DropdownMenu>
            <DropdownItem To="#units" Type="DropdownItemType.Link">Units</DropdownItem>
            <DropdownItem To="#regional" Type="DropdownItemType.Link">Regional</DropdownItem>
            <DropdownItem To="#display" Type="DropdownItemType.Link">Display</DropdownItem>
        </DropdownMenu>
    </Dropdown>

    <Dropdown Color="DropdownColor.Info">
        <DropdownToggleButton>Fuel</DropdownToggleButton>
        <DropdownMenu>
            <DropdownItem To="#fuel-defaults" Type="DropdownItemType.Link">Defaults</DropdownItem>
            <DropdownItem To="#fuel-economy" Type="DropdownItemType.Link">Economy unit</DropdownItem>
        </DropdownMenu>
    </Dropdown>

    <Dropdown Color="DropdownColor.Secondary">
        <DropdownToggleButton>Data</DropdownToggleButton>
        <DropdownMenu>
            <DropdownItem To="#data" Type="DropdownItemType.Link">Import / Export</DropdownItem>
        </DropdownMenu>
    </Dropdown>

    <Dropdown Color="DropdownColor.Warning">
        <DropdownToggleButton>Advanced</DropdownToggleButton>
        <DropdownMenu>
            <DropdownItem To="#advanced" Type="DropdownItemType.Link">App options</DropdownItem>
        </DropdownMenu>
    </Dropdown>

    <Dropdown Color="DropdownColor.Danger">
        <DropdownToggleButton>Danger Zone</DropdownToggleButton>
        <DropdownMenu>
            <DropdownItem To="#danger" Type="DropdownItemType.Link">Reset all settings</DropdownItem>
        </DropdownMenu>
    </Dropdown>
</div>

<AuthorizeView Roles="Admin">
    <Authorized>
        <UserManagement />
    </Authorized>
</AuthorizeView>

