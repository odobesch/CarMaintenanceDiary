<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CarMaintenanceDiary.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CarMaintenanceDiary.Mobile"
    xmlns:views="clr-namespace:CarMaintenanceDiary.Mobile.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="CarMaintenanceDiary.Mobile">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Vehicles"
        ContentTemplate="{DataTemplate views:VehicleListPage}"
        Route="VehicleListPage" />
    <ShellContent
        Title="Gas stations"
        ContentTemplate="{DataTemplate views:GasStationMapPage}"
        Route="GasStationMapPage" />
</Shell>
